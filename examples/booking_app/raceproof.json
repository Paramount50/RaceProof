{
  "config_version": 1,
  "id": "booking_double_reservation",
  "name": "Booking double reservation",
  "description": "Two customers both observe an available resource and reserve it.",
  "repository": ".",
  "python_paths": ["src"],
  "adapter_path": "raceproof_adapter.py",
  "adapter_factory": "create_adapter",
  "database_url_env": "RACEPROOF_DATABASE_URL",
  "operation": {
    "display_name": "reserve_resource",
    "callable": "booking_app.operations:reserve_resource",
    "source_files": ["src/booking_app/operations.py", "src/booking_app/models.py"],
    "editable_paths": ["src/booking_app/operations.py"],
    "protected_paths": ["raceproof.json", "raceproof_adapter.py", "tests"]
  },
  "actors": [
    {"id": "A", "input": {"resource_id": 1}},
    {"id": "B", "input": {"resource_id": 1}}
  ],
  "invariant": {
    "name": "exclusive_reservation",
    "description": "At most one active booking exists for a resource.",
    "approved": true
  },
  "reproduction_schedule": {
    "name": "double_reservation_interleaving",
    "description": "Both actors check availability before either inserts.",
    "actions": [
      {"kind": "wait_checkpoint", "actors": ["A", "B"], "checkpoint": "after_read"},
      {"kind": "release", "actors": ["A"], "checkpoint": "after_read"},
      {"kind": "wait_completion", "actors": ["A"]},
      {"kind": "release", "actors": ["B"], "checkpoint": "after_read"},
      {"kind": "wait_completion", "actors": ["B"]}
    ]
  },
  "investigation_schedules": [
    {
      "name": "serial_control",
      "description": "Run A to completion before B as a negative control.",
      "actions": [
        {"kind": "wait_checkpoint", "actors": ["A", "B"], "checkpoint": "before_operation"},
        {"kind": "release", "actors": ["A"], "checkpoint": "before_operation"},
        {"kind": "wait_completion", "actors": ["A"]},
        {"kind": "release", "actors": ["B"], "checkpoint": "before_operation"},
        {"kind": "wait_completion", "actors": ["B"]}
      ]
    }
  ],
  "verification_schedules": [
    {
      "name": "exact_replay",
      "description": "Replay the original semantic checkpoint schedule.",
      "actions": [
        {"kind": "wait_checkpoint", "actors": ["A", "B"], "checkpoint": "after_read"},
        {"kind": "release", "actors": ["A"], "checkpoint": "after_read"},
        {"kind": "wait_completion", "actors": ["A"]},
        {"kind": "release", "actors": ["B"], "checkpoint": "after_read"},
        {"kind": "wait_completion", "actors": ["B"]}
      ]
    },
    {
      "name": "adapted_parallel_start",
      "description": "Start both complete operations concurrently after repair.",
      "actions": [
        {"kind": "wait_checkpoint", "actors": ["A", "B"], "checkpoint": "before_operation"},
        {"kind": "release_all", "actors": ["A", "B"]},
        {"kind": "wait_completion", "actors": ["A", "B"]}
      ]
    }
  ],
  "verification": {
    "replay_count": 3,
    "allowed_outcomes": {"accepted": 1, "rejected": 1},
    "benchmark_runs": 10,
    "performance_regression_limit": 2.5,
    "regression": {"argv": ["python", "-m", "pytest", "-q", "tests"], "cwd": ".", "timeout_seconds": 60}
  },
  "limitations": ["Models exclusive booking of one resource.", "The approved invariant is application-owned."]
}
